# Copy to .env.local and fill in. Never commit real values.

# External APIs
GITHUB_TOKEN=""
STEAM_API_KEY=""

# AI assistant: off unless this is "true". When off, the chat button opens a
# "disabled" notice and nothing below is needed. To turn it on, point it at any
# OpenAI-compatible server (e.g. the self-hosted llama.cpp server, see
# docs/ai-assistant-local-llm.md).
AI_ASSISTANT_ENABLED="false"
AI_BASE_URL="https://ai.omar11.sa/v1"
AI_API_KEY=""
AI_MODEL="assistant"

# Neon Postgres: pooled URL for the app, direct URL for `npm run db:migrate`
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Neon Auth (Google/GitHub OAuth credentials are configured in the Neon Console)
NEON_AUTH_BASE_URL=""
NEON_AUTH_COOKIE_SECRET="" # at least 32 characters

# Vercel Blob (private store "omar11-private"): CV + profile photo, uploaded
# from the gitignored private/ folder with `npm run upload-private`
BLOB_READ_WRITE_TOKEN=""
